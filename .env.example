# Copy these into Portainer's "Environment variables" for the stack (or a .env file next to docker-compose.yml).
# Never commit real values to GitHub.

# REQUIRED: the Gateway password. Use the SAME value as gateway.token / core.gateway_token in nova.yaml on your PC.
NOVA_TOKEN=

# Models (downloaded automatically on first start)
BRAIN_MODEL=bonsai-2:27b
REFLEX_MODEL=bonsai-2:4b
EMBED_MODEL=nomic-embed-text
BRAIN_CONTEXT=24576
REFLEX_CONTEXT=8192

# Speech to text
WHISPER_MODEL=small.en
WHISPER_DEVICE=auto

# Cloud models (optional)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# 1 once the second V100 is in: spread the model across both cards
OLLAMA_SCHED_SPREAD=0

# Optional: where data lives on the host (default: Docker volumes). E.g. /opt/nova/data and /opt/nova/ollama
# NOVA_DATA=/opt/nova/data
# OLLAMA_DIR=/opt/nova/ollama
NOVA_PORT=8800
TZ=America/Phoenix
VOICE_ID=1
